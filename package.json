{
  "name": "enclaii-desktop",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/installer/icon-source.png --output src-tauri/icons",
    "clean:tauri": "node scripts/clean-tauri-build.js",
    "build": "tauri build",
    "build:mac": "npm run clean:tauri && npm run icons && tauri build --config src-tauri/tauri.macos.conf.json",
    "build:mac:fast": "npm run icons && tauri build --config src-tauri/tauri.macos.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:duplicated-helpers": "node scripts/check-duplicated-helpers.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.js": [
      "vitest related --run"
    ]
  }
}
