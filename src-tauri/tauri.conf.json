{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENCLAII Desktop",
  "version": "0.1.0",
  "identifier": "com.enclaii.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ENCLAII Desktop",
        "url": "app.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Grupo MediBuy",
    "category": "Medical",
    "shortDescription": "Captura local de endoscopia para ENCLAII.",
    "longDescription": "Aplicacion de escritorio para conectar camaras de endoscopia, capturar imagenes, grabar videos y sincronizar estudios con ENCLAII.",
    "copyright": "Copyright (c) 2026 ENCLAII",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": {
          "es-ES": {
            "localePath": "installer/es-ES.wxl"
          }
        },
        "upgradeCode": "cd40ff0e-2313-59cf-8a27-e0d53599fdf2",
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    }
  }
}
